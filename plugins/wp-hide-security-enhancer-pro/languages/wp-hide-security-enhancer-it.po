msgstr "<span class=\"dashicons dashicons-no\"></span>Il file readme.html è ancora accessibile."

#: include/admin-interfaces/security-scan/scan_item_hide_registration.php:29
msgid "User Registration"
msgstr "Registrazione Utente"

#: include/admin-interfaces/security-scan/scan_item_hide_registration.php:32
