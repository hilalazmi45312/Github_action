msgstr "<span class=\"dashicons dashicons-no\"></span>La Registrazione dovrebbe essere personalizzata o disabilitata tramite Dashboard > Impostazioni."

#: include/admin-interfaces/security-scan/scan_item_hide_remove_header_link.php:29 modules/components/general-headers.php:88 modules/components/general-headers.php:92
msgid "Remove Link Header"
msgstr "Rimuovi Header Link"

#: include/admin-interfaces/security-scan/scan_item_hide_remove_header_link.php:32
