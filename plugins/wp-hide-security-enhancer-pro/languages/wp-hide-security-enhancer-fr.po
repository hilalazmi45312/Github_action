msgid "<b>Google Authenticator</b>"
msgstr "<b>Google Authenticator</b>"

#: modules/components/login_2fa_app.php:58
msgid "<b>Microsoft Authenticator</b>"
msgstr "<b>Microsoft Authenticator</b>"

#: modules/components/login_2fa_app.php:59
msgid "<b>FreeOTP</b>"
msgstr "<b>FreeOTP</b>"

#: modules/components/login_2fa_app.php:60
msgid "<b>Duo Mobile</b>"
msgstr "<b>Duo Mobile</b>"

#: modules/components/login_2fa_app.php:61
msgid "<b>Authy</b>"
msgstr "<b>Authy</b>"

#: modules/components/login_2fa_app.php:62
msgid "<b>LastPass Authenticator</b>"
msgstr "<b>Authentificateur LastPass</b>"

#: modules/components/login_2fa_app.php:63
msgid ""
"These apps are available for download on both Android and iOS devices, ensuring "
"users can securely authenticate their logins from their smartphones. "
msgstr ""
"Ces applications peuvent être téléchargées sur les appareils Android et iOS, ce "
"qui permet aux utilisateurs d'authentifier leurs connexions en toute sécurité à "
"partir de leurs smartphones."

