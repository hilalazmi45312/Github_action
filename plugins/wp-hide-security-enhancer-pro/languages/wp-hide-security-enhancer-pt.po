#: modules/components/general-css-combine.php:173
#: modules/components/general-css-combine.php:177
#: modules/components/general-html.php:128 modules/components/general-html.php:132
msgid "Minify"
msgstr "Minificar"

#: modules/components/general-css-combine.php:174
msgid "Minify the combined css files. "
msgstr "Minificar os ficheiros css combinados. "

#: modules/components/general-css-combine.php:179
msgid ""
"Minify the Cascading Style Sheet data for smaller files. This slighlty increase "
"the overal site speed."
msgstr ""
"Minificar os dados de Cascading Style Sheet para ficheiros mais pequenos. Isto "
"aumenta ligeiramente a velocidade geral do site."

#: modules/components/general-css-combine.php:192
msgid "Exclude style files from CSS Combine"
msgstr "Excluir ficheiros de estilo do CSS Combinar"

#: modules/components/general-css-combine.php:197
msgid "Specify any style files which will be excluded when using CSS Combine."
msgstr ""
"Especifique quaisquer ficheiros de estilo que serão excluídos ao usar CSS "
"Combinar."

#: modules/components/general-css-combine.php:198
msgid ""
"Use only style filename and relative path e.g. <code>mediaelement.css</code>, "
"<code>plugin-slug/player.min.css</code>  one per row."
msgstr ""
"Use apenas o nome do ficheiro de estilo e caminho relativo, por exemplo "
"<code>mediaelement.css</code>, <code>plugin-slug/player.min.css</code> um por "
"linha."

#: modules/components/general-css-combine.php:199
msgid ""
"Excluding a file from processing prevents the replacements from being applied."
msgstr ""
"Excluir um ficheiro do processamento impede que as substituições sejam aplicadas."

#: modules/components/general-css-combine.php:207
msgid "Exclude CSS Block from Combine"
msgstr "Excluir Bloco CSS do Combinar"

#: modules/components/general-css-combine.php:213
msgid "Specify partial CSS code block to be excluded from Combine."
msgstr "Especifique um bloco de código CSS parcial a ser excluído do Combinar."

#: modules/components/general-css-combine.php:213
msgid ""
"Use a full line or part of it to avoid matching other codes, avoid simple words "
"which can match other CSS code. For inline styles, tag attributes can be used."
msgstr ""
"Use uma linha completa ou parte dela para evitar corresponder a outros códigos, "
"evite palavras simples que possam corresponder a outro código CSS. Para estilos "
"inline, podem ser usados atributos de tag."

